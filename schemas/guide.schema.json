                        "hints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "difficulty": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5,
                          "default": 3
                        },
                        "related_block_id": {
                          "type": "string",
                          "minLength": 1
                        }
