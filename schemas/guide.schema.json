                      "required": [
                        "id",
                        "block_type",
                        "question_type",
                        "question",
                        "correct_answer",
                        "explanation",
                        "related_block_id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "flashcard"
                        },
                        "front": {
                          "type": "string",
                          "minLength": 1
