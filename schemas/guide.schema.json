                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "instructions",
                        "starter_code"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
