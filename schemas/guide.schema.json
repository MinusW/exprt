                      "required": [
                        "id",
                        "block_type",
                        "description",
                        "variables",
                        "compute_expression",
                        "output_label"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
