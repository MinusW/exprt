                          "default": "text"
                        },
                        "answer_language": {
                          "type": "string"
                        },
                        "self_check_criteria": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        "model_answer": {
                          "type": "string"
                        },
                        "model_answer_diagram": {
                          "type": "object",
                          "properties": {
                            "diagram_type": {
                              "$ref": "5/2/properties/diagram_type"
                            },
                            "source": {
                              "type": "string",
                              "minLength": 1
                            },
                            "title": {
                              "type": "string"
                            },
                            "caption": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "diagram_type",
                            "source"
                          ],
                          "additionalProperties": false
                        },
                        "model_answer_blocks": {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "$ref": "6/0"
                              },
                              {
                                "$ref": "6/1"
                              },
                              {
                                "$ref": "6/2"
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "prompt",
                        "self_check_criteria"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "feynman_prompt"
                        },
                        "concept": {
                          "type": "string",
                          "minLength": 1
                        },
                        "prompt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target_audience": {
                          "type": "string",
                          "default": "a high school student with no background in this topic"
                        },
                        "key_points_to_cover": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "concept",
                        "prompt"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "quiz_question"
                        },
                        "question_type": {
                          "type": "string",
                          "enum": [
                            "multiple_choice",
                            "multi_select",
                            "fill_in_the_blank",
                            "code_output",
                            "short_answer"
                          ]
                        },
                        "question": {
                          "type": "string",
                          "minLength": 1
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "correct_answer": {
                          "anyOf": [
                            {
                              "type": "string"
