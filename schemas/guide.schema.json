                          "type": "string"
                        },
                        "variables": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "min": {
                                "type": "number"
                              },
                              "max": {
                                "type": "number"
                              },
                              "step": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "default": {
                                "type": "number"
                              },
                              "unit": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "min",
                              "max",
                              "step",
                              "default"
                            ],
                            "additionalProperties": false
