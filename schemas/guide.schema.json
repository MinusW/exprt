                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        },
                        "explanation": {
                          "type": "string",
                          "minLength": 1
                        },
                        "explanation_diagram": {
                          "$ref": "3/6/properties/model_answer_diagram"
