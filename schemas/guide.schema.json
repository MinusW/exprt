                        "back": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hint": {
                          "type": "string"
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "front",
                        "back"
