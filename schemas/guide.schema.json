{
  "$ref": "definitions/StudyGuide",
  "definitions": {
    "StudyGuide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "estimated_minutes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "category": {
          "type": "string"
        },
        "track": {
          "type": "string"
        },
        "track_order": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "difficulty_level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "default": "intermediate"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "layout_mode": {
          "type": "string",
          "enum": [
            "single-page",
            "multi-page"
          ],
          "default": "single-page"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url_or_path": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url_or_path"
            ],
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string"
                        },
                        "bookmarkable": {
                          "type": "boolean",
                          "default": true
                        },
                        "block_type": {
                          "type": "string",
                          "const": "markdown"
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "content"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "code"
                        },
                        "code": {
                          "type": "string"
                        },
                        "language": {
                          "type": "string",
                          "default": "typescript"
                        },
                        "filename": {
                          "type": "string"
                        },
                        "highlight_lines": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          }
                        },
                        "annotations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "line": {
                                "type": "integer",
                                "exclusiveMinimum": 0
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "line",
                              "note"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "code"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "kroki"
                        },
                        "diagram_type": {
                          "type": "string",
                          "enum": [
                            "mermaid",
                            "plantuml",
                            "graphviz",
                            "dot",
                            "excalidraw",
                            "d2",
                            "vega",
                            "vega-lite",
                            "blockdiag",
                            "c4plantuml",
                            "bpmn",
                            "bytefield",
                            "seqdiag",
                            "actdiag",
                            "nwdiag",
                            "packetdiag",
                            "rackdiag",
                            "erd",
                            "nomnoml",
                            "svgbob",
                            "umlet",
                            "wavedrom",
                            "pikchr"
                          ]
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1
                        },
                        "caption": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "diagram_type",
                        "source"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "media"
                        },
                        "media_type": {
                          "type": "string",
                          "enum": [
                            "image",
                            "audio",
                            "video",
                            "youtube"
                          ]
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "caption": {
                          "type": "string"
                        },
                        "start_time": {
                          "type": "number",
                          "minimum": 0
                        },
                        "why_watch": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "block_type",
                        "media_type",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "3/0/properties/id"
                        },
                        "title": {
                          "$ref": "3/0/properties/title"
                        },
                        "bookmarkable": {
                          "$ref": "3/0/properties/bookmarkable"
                        },
                        "block_type": {
                          "type": "string",
                          "const": "sandbox"
                        },
                        "runtime": {
                          "type": "string",
                          "enum": [
                            "javascript",
                            "html",
                            "python",
                            "c",
                            "cpp",
                            "bash",
                            "java",
                            "rust",
                            "go"
                          ],
                          "default": "javascript"
                        },
                        "runner": {
                          "type": "string",
                          "enum": [
                            "browser",
                            "docker"
                          ]
                        },
                        "docker_image": {
                          "type": "string"
                        },
                        "instructions": {
                          "type": "string",
                          "minLength": 1
