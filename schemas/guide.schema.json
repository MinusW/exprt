                          "minItems": 1
                        },
                        "compute_expression": {
                          "type": "string",
                          "minLength": 1
                        },
                        "chart_type": {
                          "type": "string",
                          "enum": [
                            "line",
                            "bar",
                            "gauge",
                            "value"
                          ],
                          "default": "value"
                        },
                        "output_label": {
                          "type": "string"
                        },
                        "output_unit": {
                          "type": "string"
                        }
